.obsidian/graph.json
.obsidian/*.bak*

# macOS 与 Obsidian 的本地产物
.DS_Store
未命名.canvas

# 站点构建产物（由 site/build.mjs 生成，部署时重建）
site/dist/

# Tencent Cloud EdgeOne
.env
.edgeone/*
.tef_dist/*

# Obsidian 插件程序与本地凭据由各设备安装和保管
.obsidian/plugins/
